{
  "profile_version": 1,
  "profile_id": "sandbox-egress-v1",
  "status": "egress_check_only",
  "network": {
    "driver": "bridge",
    "internal": true,
    "ipv6": false,
    "gateway_mode_ipv4": "isolated",
    "dns": ["127.0.0.1"],
    "target_network": "huntweave-lab-egress-targets",
    "protected": []
  },
  "workspace": {
    "mount": "/workspace"
  },
  "tool_inventory": [],
  "egress": {
    "policy_command": ["python", "/lab/network.py", "policy"],
    "read_command": ["iptables-save", "-c"],
    "policy_user": "0:0"
  },
  "gateway": {
    "image": "huntweave-isolation-probe:p0",
    "command": ["python", "/lab/network.py", "gateway"],
    "user": "0:0",
    "capabilities_add": ["NET_ADMIN"],
    "healthcheck": ["CMD", "test", "-f", "/tmp/gateway-ready"]
  },
  "tool": {
    "image": "huntweave-isolation-probe:p0",
    "command": ["python", "/lab/fixture.py", "hold"],
    "user": "10001:10001",
    "capabilities_add": [],
    "healthcheck": null
  },
  "limits": {
    "pids": 128,
    "memory": "512m",
    "cpus": 1.0,
    "read_only_rootfs": true,
    "capabilities_drop": ["ALL"],
    "no_new_privileges": true,
    "tmpfs": {"/tmp": "size=16m,mode=1777"},
    "log_tail_bytes": 65536,
    "log_line_bound": 200,
    "evidence_max_bytes": 20971520,
    "readiness_seconds": 15,
    "revocation_seconds": 5
  }
}
